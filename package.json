    "src",
    "mcp.json",
    "smithery.yaml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "x402",
    "verification",
    "sha256",
    "base",
    "usdc",
    "agent-payments"
